{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "storage.rules",
      "storage-cors.json",
      "README.md",
      "package.json",
      "package-lock.json",
      "scripts/**",
      "firebase-debug.log",
      "firestore-debug.log",
      "ui-debug.log",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
