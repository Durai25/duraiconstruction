rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isProjectCustomer(projectId) {
      return signedIn()
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.customerId == request.auth.uid;
    }

    function validContact() {
      return request.resource.data.from_name is string
        && request.resource.data.from_name.size() > 0
        && request.resource.data.from_name.size() <= 100
        && request.resource.data.reply_to is string
        && request.resource.data.reply_to.size() > 0
        && request.resource.data.reply_to.size() <= 160
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt == request.time;
    }

    match /admins/{adminId} {
      allow read: if signedIn() && (
        request.auth.token.get('admin', false) == true
        || request.auth.uid == resource.data.uid
        || request.auth.token.email == resource.data.email
      );
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['administrator', 'admin'];
      allow update, delete: if signedIn() && (
        request.auth.token.get('admin', false) == true
        || request.auth.uid == resource.data.uid
        || request.auth.token.email == resource.data.email
      );
    }

    match /customers/{customerId} {
      allow read: if isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow create: if validContact()
        && request.resource.data.keys().hasOnly([
          'from_name', 'reply_to', 'phone', 'request_type', 'project_type', 'site_location', 'preferred_date', 'message', 'createdAt'
        ])
        && request.resource.data.request_type in [
          'Project Enquiry', 'Site Visit Request', 'Free Quotation Request'
        ]
        && request.resource.data.project_type is string
        && request.resource.data.project_type.size() <= 100
        && request.resource.data.site_location is string
        && request.resource.data.site_location.size() <= 300
        && request.resource.data.preferred_date is string
        && request.resource.data.preferred_date.size() <= 20;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leadStatus', 'adminNotes', 'followUpDate'])
        && request.resource.data.get('leadStatus', 'New') in ['New', 'Contacted', 'Qualified', 'Won', 'Closed']
        && request.resource.data.get('adminNotes', '') is string
        && request.resource.data.get('adminNotes', '').size() <= 2000
        && (!('followUpDate' in request.resource.data)
          || request.resource.data.followUpDate == null
          || (request.resource.data.followUpDate is string
            && request.resource.data.followUpDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
      allow delete: if false;
    }

    match /applications/{applicationId} {
      allow create: if validContact()
        && request.resource.data.keys().hasOnly([
          'from_name', 'reply_to', 'phone', 'experience_area', 'portfolio_url', 'message', 'createdAt'
        ])
        && request.resource.data.experience_area is string
        && request.resource.data.experience_area.size() > 0
        && request.resource.data.experience_area.size() <= 100
        && request.resource.data.portfolio_url is string
        && request.resource.data.portfolio_url.size() <= 500;
      allow read, update, delete: if false;
    }

    match /projects/{projectId} {
      function validProjectRecord() {
        return request.resource.data.projectName is string
          && request.resource.data.projectName.size() > 0
          && request.resource.data.projectName.size() <= 120
          && request.resource.data.customerId is string
          && request.resource.data.customerId.size() > 0
          && request.resource.data.siteAddress is string
          && request.resource.data.siteAddress.size() > 0
          && request.resource.data.siteAddress.size() <= 300
          && request.resource.data.workStatus in ['Planning', 'In Progress', 'On Hold', 'Completed']
          && request.resource.data.progressPercent is number
          && request.resource.data.progressPercent >= 0
          && request.resource.data.progressPercent <= 100
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && (!('contractAmount' in request.resource.data)
            || request.resource.data.contractAmount == null
            || (request.resource.data.contractAmount is number && request.resource.data.contractAmount >= 0))
          && (!('budget' in request.resource.data)
            || request.resource.data.budget == null
            || (request.resource.data.budget is number && request.resource.data.budget >= 0))
          && (!('plotArea' in request.resource.data)
            || request.resource.data.plotArea == null
            || (request.resource.data.plotArea is number && request.resource.data.plotArea >= 0))
          && (!('builtUpArea' in request.resource.data)
            || request.resource.data.builtUpArea == null
            || (request.resource.data.builtUpArea is number && request.resource.data.builtUpArea >= 0));
      }

      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isAdmin()
        && validProjectRecord()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && validProjectRecord()
        && request.resource.data.createdBy == resource.data.get('createdBy', request.auth.uid)
        && request.resource.data.createdAt == resource.data.get('createdAt', request.time);
      allow delete: if isAdmin();

      match /activity/{activityId} {
        allow read: if isAdmin() || isProjectCustomer(projectId);
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['type', 'message', 'createdAt'])
          && request.resource.data.keys().hasAll(['type', 'message', 'createdAt'])
          && request.resource.data.type in ['project_created', 'project_changed']
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /payments/{paymentId} {
        allow read: if isAdmin() || isProjectCustomer(projectId);
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['installment', 'amount', 'paidAt'])
          && request.resource.data.keys().hasAll(['installment', 'amount', 'paidAt'])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.paidAt == request.time
          && (
            (paymentId == 'installment-1' && request.resource.data.installment == 1)
            || (paymentId == 'installment-2' && request.resource.data.installment == 2)
            || (paymentId == 'installment-3' && request.resource.data.installment == 3)
          );
        allow update, delete: if false;
      }

      match /updates/{updateId} {
        allow read: if isAdmin() || isProjectCustomer(projectId);
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['message', 'media', 'createdAt'])
          && request.resource.data.message is string
          && request.resource.data.message.size() <= 2000
          && request.resource.data.media is list
          && request.resource.data.media.size() <= 8
          && request.resource.data.createdAt == request.time;
        allow update, delete: if isAdmin();
      }
    }

    match /employees/{employeeId} {
      function validEmployeeProfile() {
        return request.resource.data.keys().hasOnly([
            'employeeName', 'fatherName', 'motherName', 'familySize', 'address',
            'aadhaarNumber', 'panNumber', 'bankAccountNumber', 'ifscCode',
            'mobileNumber', 'emergencyMobileNumber', 'hasBike', 'hasValidLicence',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'employeeName', 'fatherName', 'motherName', 'familySize', 'address',
            'aadhaarNumber', 'panNumber', 'bankAccountNumber', 'ifscCode',
            'mobileNumber', 'emergencyMobileNumber', 'hasBike', 'hasValidLicence',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.employeeName is string
          && request.resource.data.employeeName.size() > 0
          && request.resource.data.employeeName.size() <= 120
          && request.resource.data.fatherName is string
          && request.resource.data.fatherName.size() > 0
          && request.resource.data.fatherName.size() <= 120
          && request.resource.data.motherName is string
          && request.resource.data.motherName.size() > 0
          && request.resource.data.motherName.size() <= 120
          && request.resource.data.familySize is int
          && request.resource.data.familySize >= 1
          && request.resource.data.address is string
          && request.resource.data.address.size() > 0
          && request.resource.data.address.size() <= 500
          && request.resource.data.aadhaarNumber is string
          && request.resource.data.aadhaarNumber.matches('^[0-9]{12}$')
          && request.resource.data.panNumber is string
          && request.resource.data.panNumber.matches('^[A-Z]{5}[0-9]{4}[A-Z]$')
          && request.resource.data.bankAccountNumber is string
          && request.resource.data.bankAccountNumber.matches('^[0-9]{6,18}$')
          && request.resource.data.ifscCode is string
          && request.resource.data.ifscCode.matches('^[A-Z]{4}0[A-Z0-9]{6}$')
          && request.resource.data.mobileNumber is string
          && request.resource.data.mobileNumber.matches('^[+]?[0-9]{10,15}$')
          && request.resource.data.emergencyMobileNumber is string
          && request.resource.data.emergencyMobileNumber.matches('^[+]?[0-9]{10,15}$')
          && request.resource.data.hasBike is bool
          && request.resource.data.hasValidLicence is bool
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt == request.time;
      }

      allow read: if isAdmin();
      allow create: if isAdmin()
        && validEmployeeProfile()
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && validEmployeeProfile()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /employeeAttendance/{attendanceId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'employeeName', 'section', 'location', 'status', 'dailyWage', 'workDate', 'recordedAt'
        ])
        && request.resource.data.keys().hasAll([
          'employeeName', 'section', 'location', 'status', 'dailyWage', 'workDate', 'recordedAt'
        ])
        && request.resource.data.employeeName is string
        && request.resource.data.employeeName.size() > 0
        && request.resource.data.employeeName.size() <= 120
        && request.resource.data.section is string
        && request.resource.data.section.size() > 0
        && request.resource.data.section.size() <= 80
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.location.size() <= 200
        && request.resource.data.status in ['Present', 'Absent', 'Leave']
        && request.resource.data.dailyWage is number
        && request.resource.data.dailyWage >= 0
        && request.resource.data.workDate is string
        && request.resource.data.workDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.recordedAt == request.time;
      allow update, delete: if isAdmin();
    }

    match /employeePayouts/{payoutId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'employeeName', 'amount', 'paymentMode', 'earningMonth', 'paidAt'
        ])
        && request.resource.data.keys().hasAll([
          'employeeName', 'amount', 'paymentMode', 'earningMonth', 'paidAt'
        ])
        && request.resource.data.employeeName is string
        && request.resource.data.employeeName.size() > 0
        && request.resource.data.employeeName.size() <= 120
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.paymentMode in ['Cash', 'Bank transfer', 'UPI', 'Cheque', 'Other']
        && request.resource.data.earningMonth is string
        && request.resource.data.earningMonth.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.paidAt == request.time;
      allow update, delete: if false;
    }
  }
}
